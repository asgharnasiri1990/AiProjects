# Absolute URL for OG metadata. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is
# used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=

# Private visitor-stats page: /en/stats?token=... (and /fa/stats)
STATS_TOKEN=

# Secret slug for the bookmarkable stats screen: /en/s/<STATS_PATH>
STATS_PATH=

# Upstash for Redis / Vercel KV (injected by the Vercel Storage integration).
# Either pair works; Vercel KV names take priority.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional third-party analytics. Enable at most one of the two.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
